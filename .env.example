# Private key for deploying contracts (without 0x prefix)
PRIVATE_KEY=

# Base Sepolia RPC URL (default: https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=

# Base Mainnet RPC URL (default: https://mainnet.base.org)
BASE_MAINNET_RPC_URL=

# Basescan API Key for contract verification
BASESCAN_API_KEY=

# --- MultiSig Configuration ---
# Minimum 3 owners, threshold >= 2 for production
MULTISIG_OWNER_1=
MULTISIG_OWNER_2=
MULTISIG_OWNER_3=
MULTISIG_THRESHOLD=2

# --- Operator Addresses (daily operations, no governance delay) ---
# KYC operator: can addUser, removeUser, batchAddUsers, updateKYCLevel,
#               addApprovedContract, removeApprovedContract
KYC_OPERATOR_ADDRESS=

# Registry operator: can updateIPFSDocument, updatePropertyName,
#                    updatePropertyValue, deactivateProperty, reactivateProperty
REGISTRY_OPERATOR_ADDRESS=

# Factory operator: can call createPropertyToken (deploy new property tokens
#                   + auto-register metadata). Kept separate from the
#                   registry operator so responsibilities can be rotated
#                   independently if needed.
FACTORY_OPERATOR_ADDRESS=
